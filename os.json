import json
import urllib.error
import urllib.request
from datetime import datetime


def doviz_kurunu_getir_ve_kaydet():
  # Frankfurter API endpoint'i (TRY -> EUR dönüşümü)
  url = "https://api.frankfurter.app/latest?from=TRY&to=EUR"

  try:
    print("API'den güncel döviz kurları alınıyor...")

    # 1. Adım: API isteği yapma ve veriyi çekme (Hata yönetimi ile)
    with urllib.request.urlopen(url, timeout=10) as response:
      response_data = response.read().decode("utf-8")
      data = json.loads(response_data)

    # Gelen veriyi kontrol etme
    if "rates" not in data or "EUR" not in data["rates"]:
      raise ValueError(
          "API yanıtı beklenen formatta değil veya kur bilgisi bulunamadı."
      )

    # 2. Adım: 100 birimi güncel kur üzerinden çevirme
    kur = data["rates"]["EUR"]
    miktar = 100
    cevrilen_tutar = miktar * kur

    # Rapor verisini hazırlama
    zaman = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    rapor_verisi = {
        "zaman": zaman,
        "islem": f"{miktar} TRY -> EUR",
        "guncel_kur": kur,
        "sonuc": round(cevrilen_tutar, 4),
    }

    # 3. Adım: Verileri bir JSON dosyasına kaydetme
    dosya_adi = "doviz_raporu.json"
    with open(dosya_adi, "w", encoding="utf-8") as dosya:
      json.dump(rapor_verisi, dosya, ensure_ascii=False, indent=4)

    print("\n[BAŞARILI] İşlem tamamlandı!")
    print(f"-> 100 TRY = {cevrilen_tutar:.4f} EUR (Kur: {kur})")
    print(f"-> Sonuçlar '{dosya_adi}' dosyasına kaydedildi.")

  # 4. Adım: Kapsamlı Hata Yönetimi (Error Handling)
  except urllib.error.URLError as e:
    print(
        f"\n[BAĞLANTI HATASI] API'ye ulaşılamadı. İnternet bağlantınızı veya"
        f" servis durumunu kontrol edin.\nDetay: {e.reason}"
    )
  except json.JSONDecodeError:
    print(
        "\n[VERİ HATASI] API'den gelen yanıt geçerli bir JSON formatında değil."
    )
  except ValueError as e:
    print(f"\n[MANTIKSEL HATA] {e}")
  except IOError as e:
    print(f"\n[DOSYA HATASI] Dosya yazma/okuma sırasında bir sorun oluştu: {e}")
  except Exception as e:
    print(f"\n[BEKLENMEYEN HATA] Beklenmeyen bir durum oluştu: {e}")


if __name__ == "__main__":
  doviz_kurunu_getir_ve_kaydet()